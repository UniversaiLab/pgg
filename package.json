{
  "name": "pgg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-only Web3 poker. Derived from pok3rNetwork/pok3r (MIT).",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --hot apps/server/src/index.js",
    "dev:web": "cd apps/web && bun run dev",
    "build:web": "cd apps/web && bun run build",
    "test": "bun test ./apps ./packages",
    "test:contracts": "cd contracts && forge test",
    "build:contracts": "cd contracts && forge build",
    "vector": "bun packages/protocol/scripts/vault-vector.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bots": "bun apps/server/scripts/bots.js",
    "loadtest": "bun apps/server/scripts/loadtest.js",
    "shots": "bun apps/web/scripts/shots.js",
    "size": "bun apps/web/scripts/size.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
