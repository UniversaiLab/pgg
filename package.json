{
  "name": "pgg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-only Web3 poker. Derived from pok3rNetwork/pok3r (MIT).",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --hot apps/server/src/index.js",
    "dev:web": "bun --cwd apps/web run dev",
    "build:web": "bun --cwd apps/web run build",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bots": "bun apps/server/scripts/bots.js",
    "loadtest": "bun apps/server/scripts/loadtest.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
